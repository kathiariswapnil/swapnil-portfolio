---
import { writing } from "../data/site";
---

<section id="writing" class="reveal-section py-24 md:py-32 px-6 bg-white/40">
  <div class="mx-auto max-w-6xl">
    <div class="reveal-item mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="section-label">Writing</p>
        <h2 class="font-serif text-4xl md:text-5xl text-ink mt-3">
          Thought leadership
        </h2>
        <p class="mt-4 text-ink-muted">
          Articles and notes from Medium. Replace placeholders with your
          screenshots when ready.
        </p>
      </div>
      <a
        href="https://medium.com/@email.swapnill"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline"
      >
        View all on Medium →
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        writing.map((post) => (
          <a
            href={post.url}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal-item group block overflow-hidden rounded-2xl border border-border bg-white/70 transition-all hover:border-accent/30 hover:shadow-lg"
          >
            <div class="aspect-[16/10] overflow-hidden bg-accent-soft/30 border-b border-border">
              <img
                src={post.image}
                alt=""
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width="400"
                height="250"
              />
            </div>
            <div class="p-6">
              <h3 class="font-serif text-xl text-ink group-hover:text-accent transition-colors">
                {post.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                {post.excerpt}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

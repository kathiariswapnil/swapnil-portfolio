---
interface Props {
  value: string;
  label: string;
  context: string;
}

const { value, label, context } = Astro.props;
---

<article
  class="reveal-item metric-card group rounded-2xl border border-border bg-white/60 p-6 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
>
  <p class="font-serif text-4xl md:text-5xl text-accent">{value}</p>
  <p class="mt-3 font-medium text-ink">{label}</p>
  <p class="mt-1 text-sm text-ink-muted">{context}</p>
</article>

---
import { site } from "../data/site";
import { asset } from "../lib/assets";
---

<section id="about" class="reveal-section py-24 md:py-32 px-6">
  <div class="mx-auto max-w-6xl grid gap-12 lg:grid-cols-[1fr_340px] items-start">
    <div class="reveal-item space-y-6">
      <p class="section-label">About</p>
      <h2 class="font-serif text-4xl md:text-5xl text-ink leading-tight">
        QA roots. PM mindset.<br />AI-native delivery.
      </h2>
      <p class="text-lg leading-relaxed text-ink-muted max-w-2xl">
        {site.summary}
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <span
          class="rounded-full bg-accent-soft px-4 py-1.5 text-sm font-medium text-accent"
          >B2B SaaS</span
        >
        <span
          class="rounded-full bg-accent-soft px-4 py-1.5 text-sm font-medium text-accent"
          >Finance & Reporting</span
        >
        <span
          class="rounded-full bg-accent-soft px-4 py-1.5 text-sm font-medium text-accent"
          >Agentic AI</span
        >
      </div>
    </div>

    <div class="reveal-item profile-portrait">
      <div class="profile-portrait__glow" aria-hidden="true"></div>
      <figure class="profile-portrait__frame glass-card">
        <img
          src={asset("/images/swapnil-profile.png")}
          alt={`${site.name} — Product Manager`}
          class="profile-portrait__image"
          width="340"
          height="425"
          loading="lazy"
        />
        <figcaption class="profile-portrait__caption">
          <p class="font-serif text-lg text-ink">{site.name}</p>
          <p class="text-sm text-ink-muted">{site.role} · {site.location}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .profile-portrait {
    position: relative;
  }

  .profile-portrait__glow {
    position: absolute;
    inset: 6% -8% -6% -8%;
    background: radial-gradient(
      circle at 50% 40%,
      rgba(91, 79, 255, 0.28) 0%,
      rgba(155, 140, 255, 0.12) 45%,
      transparent 72%
    );
    filter: blur(20px);
    animation: portrait-glow 8s ease-in-out infinite;
  }

  @keyframes portrait-glow {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  .profile-portrait__frame {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    padding: 0.65rem;
    box-shadow:
      0 24px 60px rgba(91, 79, 255, 0.16),
      0 0 0 1px rgba(255, 255, 255, 0.7) inset;
  }

  .profile-portrait__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.85rem;
    object-fit: cover;
  }

  .profile-portrait__caption {
    padding: 1rem 0.35rem 0.25rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-portrait__glow {
      animation: none;
    }
  }
</style>

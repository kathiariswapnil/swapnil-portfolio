---
import { experience } from "../data/site";
---

<section id="experience" class="reveal-section scroll-mt-24 py-24 md:py-32 px-6">
  <div class="mx-auto max-w-6xl">
    <div class="reveal-item mb-16 max-w-2xl mx-auto text-center">
      <p class="section-label">Experience</p>
      <h2 class="font-serif text-4xl md:text-5xl text-ink mt-3">
        Where I've built
      </h2>s
    </div>

    <ol class="timeline relative mx-auto max-w-2xl">
      <div
        class="timeline-line absolute left-[11px] md:left-1/2 md:-translate-x-1/2 top-3 bottom-3 w-px bg-border origin-top scale-y-0"
        aria-hidden="true"
      >
      </div>

      {
        experience.map((item) => (
          <li class="timeline-item reveal-item relative pb-12 last:pb-0">
            <div class="relative pl-10 md:pl-0 md:pt-2">
              <span
                class="timeline-dot absolute left-[5px] md:left-1/2 md:-translate-x-1/2 top-2.5 z-10 h-3.5 w-3.5 rounded-full border-2 border-accent bg-paper"
                aria-hidden="true"
              />

              <article class="rounded-2xl glass-card p-6 md:mx-auto md:max-w-lg text-center">
                <p class="font-serif text-2xl text-ink leading-tight">
                  {item.company}
                </p>
                <p class="text-sm text-ink-muted mt-1">
                  {item.period} · {item.location}
                </p>
                <p class="font-medium text-accent mt-4">{item.role}</p>

                <ul class="mt-4 space-y-3 text-left md:mx-auto md:max-w-md">
                  {item.highlights.map((highlight) => (
                    <li class="timeline-bullet text-sm leading-relaxed text-ink-muted">
                      {highlight}
                    </li>
                  ))}
                </ul>
              </article>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline-bullet {
    padding-left: 1rem;
    position: relative;
  }

  .timeline-bullet::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: var(--color-accent);
  }

  @media (min-width: 768px) {
    .timeline-item {
      padding-top: 0.5rem;
    }
  }
</style>

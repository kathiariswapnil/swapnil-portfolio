---
import { skills } from "../data/site";
---

<section id="skills" class="reveal-section py-24 md:py-32 px-6">
  <div class="mx-auto max-w-6xl">
    <div class="reveal-item mb-12 max-w-2xl">
      <p class="section-label">Skills</p>
      <h2 class="font-serif text-4xl md:text-5xl text-ink mt-3">
        How I work
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        skills.map((group, index) => (
          <article
            class={`reveal-item rounded-2xl border border-border bg-white/60 p-6 md:p-8 ${index === 3 ? "sm:col-span-2 lg:col-span-1" : ""}`}
          >
            <h3 class="font-serif text-2xl text-ink">{group.title}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-full border border-border bg-paper px-3 py-1.5 text-sm text-ink-muted">
                  {item}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

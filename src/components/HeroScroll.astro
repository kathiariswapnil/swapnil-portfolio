---
import { site, heroMetrics } from "../data/site";

const [firstName, ...restName] = site.name.split(" ");
const lastName = restName.join(" ");
---

<section
  id="hero"
  class="hero-scroll-section relative overflow-hidden"
  aria-label="Introduction"
>
  <div
    class="hero-static md:hidden px-6 pt-32 pb-20 max-w-4xl mx-auto relative z-10 flex flex-col items-center gap-8 text-center"
  >
    <p class="section-label w-full text-center">Product Manager · Bengaluru</p>
    <h1 class="hero-name font-serif text-5xl leading-tight text-ink">
      <span class="hero-name__line">{firstName}</span>
      <span class="hero-name__line">{lastName}</span>
    </h1>
    <p class="text-xl leading-relaxed text-ink-muted max-w-2xl">
      {site.thesis}
    </p>
    <div class="flex flex-wrap justify-center gap-8 w-full">
      {
        heroMetrics.map((metric) => (
          <div class="text-center">
            <p class="font-serif text-4xl text-accent">
              {metric.value}
              {metric.suffix}
            </p>
            <p class="text-sm text-ink-muted mt-1">{metric.label}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hero-sticky hidden md:grid md:h-screen md:w-full md:place-items-center md:z-10">
    <div class="hero-stage">
      <div class="hero-beat hero-beat-1 hero-beat-layer">
        <div class="hero-beat-content">
          <p class="section-label">Product Manager · Bengaluru</p>
          <h1 class="hero-name font-serif text-6xl lg:text-7xl leading-[1.05] text-ink">
            <span class="hero-name__line">{firstName}</span>
            <span class="hero-name__line">{lastName}</span>
          </h1>
        </div>
      </div>

      <div class="hero-beat hero-beat-2 hero-beat-layer">
        <div class="hero-beat-content">
          <p class="hero-thesis font-serif text-3xl lg:text-4xl leading-snug text-ink italic">
            {site.thesis}
          </p>
        </div>
      </div>

      <div class="hero-beat hero-beat-3 hero-beat-layer">
        <div class="hero-beat-content">
          <div class="hero-metrics">
          {
            heroMetrics.map((metric) => (
              <div class="text-center">
                <p
                  class="font-serif text-5xl lg:text-6xl text-accent hero-counter"
                  data-target={metric.value}
                  data-suffix={metric.suffix}
                >
                  0{metric.suffix}
                </p>
                <p class="text-sm text-ink-muted mt-2 max-w-[140px] mx-auto">
                  {metric.label}
                </p>
              </div>
            ))
          }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import HeroScroll from "../components/HeroScroll.astro";
import About from "../components/About.astro";
import ImpactMetrics from "../components/ImpactMetrics.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import SkillsBento from "../components/SkillsBento.astro";
import Writing from "../components/Writing.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout>
  <Nav />
  <main id="main">
    <HeroScroll />
    <About />
    <ImpactMetrics />
    <Timeline />
    <Projects />
    <SkillsBento />
    <Writing />
    <Contact />
  </main>
</BaseLayout>

<script>
  import { initSmoothScroll, refreshScroll } from "../scripts/lenis";
  import { initHeroScroll } from "../scripts/heroScroll";
  import { initSectionReveals } from "../scripts/sectionReveals";

  initSmoothScroll();
  initHeroScroll();
  initSectionReveals();

  requestAnimationFrame(() => refreshScroll());

  window.addEventListener("load", () => {
    refreshScroll();
  });
</script>

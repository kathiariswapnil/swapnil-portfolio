---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import HeroScroll from "../components/HeroScroll.astro";
import About from "../components/About.astro";
import ImpactMetrics from "../components/ImpactMetrics.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import SkillsBento from "../components/SkillsBento.astro";
import Writing from "../components/Writing.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout>
  <Nav />
  <main id="main">
    <HeroScroll />
    <About />
    <ImpactMetrics />
    <Timeline />
    <Projects />
    <SkillsBento />
    <Writing />
    <Contact />
  </main>
</BaseLayout>

<script>
  import { initSmoothScroll, refreshScroll } from "../scripts/lenis";
  import { initHeroScroll } from "../scripts/heroScroll";
  import { initSectionReveals } from "../scripts/sectionReveals";

  initSmoothScroll();
  initHeroScroll();
  initSectionReveals();

  requestAnimationFrame(() => refreshScroll());

  window.addEventListener("load", () => {
    refreshScroll();

    // #region agent log
    fetch("http://127.0.0.1:7508/ingest/6e0bcafd-3289-4c1a-9f73-3e688de1ad67", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Debug-Session-Id": "2b84c8",
      },
      body: JSON.stringify({
        sessionId: "2b84c8",
        runId: "post-fix",
        hypothesisId: "H4",
        location: "src/pages/index.astro:44",
        message: "Browser base and rendered image state",
        data: {
          href: window.location.href,
          baseURI: document.baseURI,
          viteBase: import.meta.env.BASE_URL,
          images: Array.from(document.images).map((image) => ({
            src: image.getAttribute("src"),
            currentSrc: image.currentSrc,
            complete: image.complete,
            naturalWidth: image.naturalWidth,
          })),
          resumeHrefs: Array.from(
            document.querySelectorAll('a[download]'),
          ).map((anchor) => (anchor as HTMLAnchorElement).getAttribute("href")),
        },
        timestamp: Date.now(),
      }),
    }).catch(() => {});
    // #endregion

    void (async () => {
      const rootAsset =
        "https://kathiariswapnil.github.io/images/page-background-v3.png";
      const baseAsset =
        "https://kathiariswapnil.github.io/swapnil-portfolio/images/page-background-v3.png";

      try {
        const response = await fetch(rootAsset, { method: "HEAD" });
        // #region agent log
        fetch("http://127.0.0.1:7508/ingest/6e0bcafd-3289-4c1a-9f73-3e688de1ad67", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-Debug-Session-Id": "2b84c8",
          },
          body: JSON.stringify({
            sessionId: "2b84c8",
            runId: "post-fix",
            hypothesisId: "H1",
            location: "src/pages/index.astro:79",
            message: "Production root-relative asset probe",
            data: {
              url: rootAsset,
              status: response.status,
              ok: response.ok,
              contentType: response.headers.get("content-type"),
            },
            timestamp: Date.now(),
          }),
        }).catch(() => {});
        // #endregion
      } catch (error) {
        // #region agent log
        fetch("http://127.0.0.1:7508/ingest/6e0bcafd-3289-4c1a-9f73-3e688de1ad67", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-Debug-Session-Id": "2b84c8",
          },
          body: JSON.stringify({
            sessionId: "2b84c8",
            runId: "post-fix",
            hypothesisId: "H1",
            location: "src/pages/index.astro:102",
            message: "Production root-relative asset probe failed",
            data: { error: String(error) },
            timestamp: Date.now(),
          }),
        }).catch(() => {});
        // #endregion
      }

      try {
        const response = await fetch(baseAsset, { method: "HEAD" });
        // #region agent log
        fetch("http://127.0.0.1:7508/ingest/6e0bcafd-3289-4c1a-9f73-3e688de1ad67", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-Debug-Session-Id": "2b84c8",
          },
          body: JSON.stringify({
            sessionId: "2b84c8",
            runId: "post-fix",
            hypothesisId: "H2-H3",
            location: "src/pages/index.astro:126",
            message: "Production base-prefixed asset probe",
            data: {
              url: baseAsset,
              status: response.status,
              ok: response.ok,
              contentType: response.headers.get("content-type"),
            },
            timestamp: Date.now(),
          }),
        }).catch(() => {});
        // #endregion
      } catch (error) {
        // #region agent log
        fetch("http://127.0.0.1:7508/ingest/6e0bcafd-3289-4c1a-9f73-3e688de1ad67", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-Debug-Session-Id": "2b84c8",
          },
          body: JSON.stringify({
            sessionId: "2b84c8",
            runId: "post-fix",
            hypothesisId: "H2-H3",
            location: "src/pages/index.astro:149",
            message: "Production base-prefixed asset probe failed",
            data: { error: String(error) },
            timestamp: Date.now(),
          }),
        }).catch(() => {});
        // #endregion
      }

      const resumeUrls = [
        "https://kathiariswapnil.github.io/resume.pdf",
        "https://kathiariswapnil.github.io/swapnil-portfolio/resume.pdf",
      ];
      const resumeResults = await Promise.all(
        resumeUrls.map(async (url) => {
          try {
            const response = await fetch(url, { method: "HEAD" });
            return {
              url,
              status: response.status,
              ok: response.ok,
              contentType: response.headers.get("content-type"),
            };
          } catch (error) {
            return { url, error: String(error) };
          }
        }),
      );
      // #region agent log
      fetch("http://127.0.0.1:7508/ingest/6e0bcafd-3289-4c1a-9f73-3e688de1ad67", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Debug-Session-Id": "2b84c8",
        },
        body: JSON.stringify({
          sessionId: "2b84c8",
          runId: "post-fix",
          hypothesisId: "H5",
          location: "src/pages/index.astro:179",
          message: "Production resume probes",
          data: { results: resumeResults },
          timestamp: Date.now(),
        }),
      }).catch(() => {});
      // #endregion
    })();
  });
</script>
